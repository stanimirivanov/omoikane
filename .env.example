# Server
OMOIKANE_ENV=local
OMOIKANE_SERVER_HOST=0.0.0.0
OMOIKANE_SERVER_PORT=3333
OMOIKANE_SERVER_VERSION=development
OMOIKANE_READINESS_TIMEOUT_MS=2000
OMOIKANE_ALLOWED_ORIGINS=http://localhost:4200
OTEL_EXPORTER_OTLP_ENDPOINT=
OMOIKANE_TELEMETRY_SHUTDOWN_TIMEOUT_MS=3000

# AI worker
OMOIKANE_AI_WORKER_HOST=0.0.0.0
OMOIKANE_AI_WORKER_PORT=3334
OMOIKANE_AI_WORKER_VERSION=development
OMOIKANE_AI_WORKER_ID=
OMOIKANE_AI_WORKER_POLL_INTERVAL_MS=1000
OMOIKANE_AI_WORKER_JOB_LEASE_SECONDS=60
OMOIKANE_AI_WORKER_DRAIN_TIMEOUT_MS=5000

# Optional local Decision Forensics processor. Supplying URL and model enables
# model extraction; leaving both blank preserves the deterministic processor.
OMOIKANE_OLLAMA_BASE_URL=
OMOIKANE_DECISION_FORENSICS_MODEL=
OMOIKANE_OLLAMA_TIMEOUT_MS=30000
OMOIKANE_OLLAMA_MODEL=qwen3:4b-instruct

# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<from-pnpm-supabase-status>
SUPABASE_SECRET_KEY=<SECRET_KEY-from-pnpm-supabase-status>
# Compatibility fallback for projects that still use legacy JWT keys:
SUPABASE_SERVICE_ROLE_KEY=
